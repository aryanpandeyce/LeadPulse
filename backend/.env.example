# Application
APP_NAME=LeadPulse API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Database (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://leadpulse:leadpulse_dev_pw@localhost:5434/leadpulse
DIRECT_DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
PROCESS_POOL_MAX_WORKERS=2

# Seed Configuration
SEED_SIZE=full
SEED_ADMIN_PASSWORD=Admin@123
SEED_AGENT_PASSWORD=Agent@123

# Redis (Cache, Rate Limiting, Idempotency)
REDIS_URL=redis://localhost:6380/0
KPI_CACHE_TTL_SECONDS=300
LLM_CACHE_TTL_SECONDS=3600

# Security & Auth
JWT_SECRET_KEY=change-me-in-production-to-a-secure-32-byte-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000"]

# LLM Provider Configuration (Provider-agnostic: "mock" | "openai" | "anthropic")
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_CHEAP_MODEL=gpt-4o-mini
LLM_STRONG_MODEL=gpt-4o
LLM_DAILY_USER_BUDGET_USD=1.00
LLM_RATE_LIMIT_PER_MINUTE=20

# Feature Flags (Concept 9: Balancing Shipping Speed vs Code Quality)
FEATURE_AI_STREAMING=true
FEATURE_SMART_CAPTURE_RETRY=true

